<?xml version="1.0" encoding="UTF-8"?>
<!--
  spectHR main window chrome.

  Holds only the QMainWindow shell, menubar, statusbar and QActions.
  The dock layout (workspace tree, analysis tabs, log) is built in
  MainWindow.__init__ via PySide6-QtAds; the View menu is populated
  at runtime from each dock's toggleViewAction.

  Keep action objectNames stable, MainWindow.py wires slots by name.
-->
<ui version="4.0">
 <class>MainWindow</class>
