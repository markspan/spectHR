{
    "_description": "Task Force of the European Society of Cardiology / North American Society of Pacing and Electrophysiology (1996) standard frequency bands. Deep-merged on top of the default workspace; only the keys that differ are listed here.",

    "FrequencyAnalysis": {
        "method": "welch",
        "plot_units": "ms²/Hz",

        "bands": {
            "TP":  {"low": 0.0033, "high": 0.40, "color": "gray",      "alpha": 0.35},
            "VLF": {"low": 0.0033, "high": 0.04, "color": "purple",    "alpha": 0.20},
            "LF":  {"low": 0.04,   "high": 0.15, "color": "darkgreen"              },
            "HF":  {"low": 0.15,   "high": 0.40, "color": "red"                    }
        },

        "welch": {
            "fs":       4.0,
            "nperseg":  1024,
            "noverlap": 512,
            "nfft":     1024,
            "window":   "hann"
        }
    }
}
